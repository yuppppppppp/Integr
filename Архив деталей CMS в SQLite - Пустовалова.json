        "jsCode": "const syncTime = new Date().toISOString();\n\nreturn $input.all().map((item) => {\n  const source = item.json;\n\n  if (!source.spareCode) {\n    throw new Error('CMS вернула деталь без spareCode');\n  }\n\n  return {\n    json: {\n      spare_code: source.spareCode,\n      spare_name: source.spareName,\n      spare_description: source.spareDescription ?? '',\n      spare_type: source.spareType,\n      spare_status: source.spareStatus,\n      price: String(source.price),\n      quantity: Number(source.quantity),\n      source_updated_at: source.updatedAt,\n      last_synced_at: syncTime,\n    },\n  };\n});"
      },
