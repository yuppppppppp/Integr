    {
      "parameters": {
        "jsCode": "function escapeCsv(value) {\n  const text = value == null ? '' : String(value);\n  const escaped = text.replace(/\"/g, '\"\"');\n\n  return /[;\"\\r\\n]/.test(text)\n    ? `\"${escaped}\"`\n    : escaped;\n}\n\nconst rows = $input.all().map((item) => item.json);\n\nconst csv = rows\n  .map((row) => [\n    row.spare_code,\n    row.spare_name,\n    row.spare_description,\n    row.spare_type,\n    row.spare_status,\n    row.price,\n    row.quantity,\n    row.source_updated_at,\n  ].map(escapeCsv).join(';'))\n  .join('\\n');\n\nreturn [{\n  json: {\n    csv,\n    rowCount: rows.length,\n    generatedAt: new Date().toISOString(),\n  },\n}];"
      },
